<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Generates the strongly typed DomainErrors class from the .resx at build time -->
    <EmbeddedResource Update="Resources\DomainErrors.resx">
      <StronglyTypedFileName>$(IntermediateOutputPath)DomainErrors.Designer.cs</StronglyTypedFileName>
      <StronglyTypedLanguage>CSharp</StronglyTypedLanguage>
      <StronglyTypedNamespace>Orders.Domain.Resources</StronglyTypedNamespace>
      <StronglyTypedClassName>DomainErrors</StronglyTypedClassName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
