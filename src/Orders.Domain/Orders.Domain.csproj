<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- The IDE regenerates DomainErrors.Designer.cs (strongly typed class) whenever the .resx is edited -->
    <EmbeddedResource Update="Resources\DomainErrors.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>DomainErrors.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <Compile Update="Resources\DomainErrors.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>DomainErrors.resx</DependentUpon>
    </Compile>
  </ItemGroup>

</Project>
