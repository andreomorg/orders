<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Orders.Domain\Orders.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- The IDE regenerates ApplicationErrors.Designer.cs (strongly typed class) whenever the .resx is edited -->
    <EmbeddedResource Update="Resources\ApplicationErrors.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>ApplicationErrors.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <Compile Update="Resources\ApplicationErrors.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>ApplicationErrors.resx</DependentUpon>
    </Compile>
  </ItemGroup>

</Project>
